# 官方 nginx 镜像：放到 /etc/nginx/templates/，启动时用 envsubst 注入 ${TDT_SERVER_KEY}
# (只替换已定义的环境变量，$args 等 Nginx 变量不受影响)。见 docs/FRONTEND_ARCHITECTURE.md §6
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # 萤石视频 (EZUIKit)：解码库来自 openstatic.ys7.com (WebAssembly)，接口 open.ys7.com，取流 wss://*.ys7.com:端口
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.tianditu.gov.cn https://*.aliyuncs.com https://*.ys7.com; connect-src 'self' https://*.aliyuncs.com https://*.ys7.com https://*.ys7.com:* wss://*.ys7.com:*; style-src 'self' 'unsafe-inline' https://openstatic.ys7.com; script-src 'self' 'wasm-unsafe-eval' https://openstatic.ys7.com; worker-src 'self' blob: https://openstatic.ys7.com; media-src 'self' blob:; font-src 'self' data: https://openstatic.ys7.com" always;

    location = /index.html { add_header Cache-Control "no-cache"; }
    location /assets/      { add_header Cache-Control "public, max-age=31536000, immutable"; }
    location /             { try_files $uri $uri/ /index.html; }

    location /api/ {
        proxy_pass http://127.0.0.1:10888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }

    # 历史数据流式输出：关闭缓冲，后端最长 5 分钟
    location ~ ^/api/v1/app/devices/\d+/history$ {
        proxy_pass http://127.0.0.1:10888;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 330s;
    }

    # 天地图搜索 / 逆地理编码：追加服务端 Key，不暴露给浏览器
    location /tdt-api/ {
        rewrite ^/tdt-api/(.*)$ /$1 break;
        set $args "$args&tk=${TDT_SERVER_KEY}";
        proxy_pass https://api.tianditu.gov.cn;
        proxy_set_header Host api.tianditu.gov.cn;
        proxy_ssl_server_name on;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
